# =============================================================================
# Voice-Driven Data Analyst — environment template
# Copy to `.env` at the repo root (backend Settings loads this file).
# Every variable below maps to `backend/app/config.py` (aliases / defaults).
# Frontend vars live in `frontend/.env.local.example`.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Project database (ORM + Alembic) — APP_DB_*
# -----------------------------------------------------------------------------
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=bi_app
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
# Optional — leave empty to use PostgreSQL default schema (public)
APP_DB_SCHEMA=
# SQLAlchemy async pool (each connection holds buffers)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Encrypts user-provided warehouse passwords stored in app.data_sources
CREDENTIALS_SECRET=change-me-to-a-long-random-secret-string

# -----------------------------------------------------------------------------
# AI provider (OpenRouter-compatible)
# -----------------------------------------------------------------------------
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-replace-with-your-key
LLM_MODEL=openai/gpt-oss-20b:free
LLM_MODEL_FALLBACK=google/gemma-4-31b-it:free
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIMENSIONS=2048

# -----------------------------------------------------------------------------
# Chat / RAG / warehouse query knobs
# -----------------------------------------------------------------------------
RAG_TOP_K=5
RAG_EXPAND_HOPS=1
RAG_MAX_TABLES=15
RAG_EXPAND_ON_RETRY=true
SQL_MAX_ATTEMPTS=3
WAREHOUSE_MAX_ROWS=500
CHAT_HISTORY_LIMIT=5
WAREHOUSE_CONNECT_TIMEOUT_SECONDS=10
WAREHOUSE_STATEMENT_TIMEOUT_MS=15000
# Leave unset to allow private/loopback warehouse hosts only when APP_ENV=local
# WAREHOUSE_ALLOW_PRIVATE_HOSTS=true

# Warehouse credentials are supplied via POST /api/data/connect (not stored here).
# schema_name is optional; omit to use the PostgreSQL connection default.
# Local demo warehouse schema: sales (see Makefile DEMO_WH_SCHEMA).
# Typical flow: connect → embed-schema → chat (prepare: RAG + FK expand → LangGraph)
# After warehouse DDL: Evidence panel → Refresh schema index (POST /api/data/embed-schema)

# -----------------------------------------------------------------------------
# CSV / Excel upload limits
# Uploads use APP_DB_* (isolated schema per file). No separate warehouse needed.
# -----------------------------------------------------------------------------
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=50000
# Legacy / unused by the upload path — safe to omit (kept for old .env files)
# UPLOAD_WH_HOST=localhost
# UPLOAD_WH_PORT=5433
# UPLOAD_WH_DATABASE=bi_warehouse
# UPLOAD_WH_USER=bi_uploader
# UPLOAD_WH_PASSWORD=uploader_pass
# UPLOAD_WH_QUERY_USER=bi_readonly
# UPLOAD_WH_QUERY_PASSWORD=readonly_pass

# -----------------------------------------------------------------------------
# Auth (JWT + optional Gmail SMTP OTP — no Google Sign-In / OIDC)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_MINUTES=10080
JWT_ISSUER=voice-driven-data-analyst
# httpOnly cookies carry access + refresh JWTs (not localStorage).
# Prefer first-party cookies: leave the browser on same-origin /api via Next rewrite
# (Vercel API_PROXY_TARGET → Render). That works on iOS Safari / Android Chrome.
# AUTH_COOKIE_SAMESITE=lax is correct with the proxy. Use none ONLY if the browser
# calls the API host directly (often broken on mobile even with Secure).
AUTH_ACCESS_COOKIE_NAME=vdda_access
AUTH_REFRESH_COOKIE_NAME=vdda_refresh
AUTH_COOKIE_SAMESITE=lax
# Leave unset → Secure off only when APP_ENV=local; always on for SameSite=none
# AUTH_COOKIE_SECURE=

# -----------------------------------------------------------------------------
# Rate limits (per IP / identity, per minute)
# -----------------------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=20
CONNECT_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_MINUTE=30
EMBED_RATE_LIMIT_PER_MINUTE=10
TTS_RATE_LIMIT_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Offline Piper TTS (bundled en_US-amy-low under backend/models/piper/)
# TTS_MAX_CHARS = max size PER CHUNK (full answer is still spoken via many chunks).
# Defaults favor fast Speak. On Render free (512MB) if you OOM, set:
#   TTS_PRELOAD=false  and/or  TTS_ENABLED=false
# -----------------------------------------------------------------------------
TTS_ENABLED=true
TTS_PRELOAD=true
TTS_VOICE_PATH=models/piper/en_US-amy-low.onnx
TTS_MAX_CHARS=180
TTS_FIRST_CHUNK_CHARS=48
TTS_LENGTH_SCALE=0.78
TTS_ONNX_THREADS=1
TTS_WARMUP_ENABLED=true
TTS_WARMUP_TEXT=Ready.
TTS_WAV_CACHE_MAX=12
TTS_WAV_CACHE_MAX_BYTES=12000000

# -----------------------------------------------------------------------------
# Email OTP (registration verification)
# Set EMAIL_OTP_ENABLED=false on hosts that block outbound SMTP (e.g. Render free).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
EMAIL_OTP_ENABLED=true
# Default false — set true to allow new sign-ups (login always works for existing users).
REGISTRATION_ENABLED=false

# Ops (not loaded by Settings — used by GitHub Actions / deploy)
# Set as a GitHub Actions repository *secret* (not in Render).
# If Keep-alive fails with "runner not acquired" but curl /health is OK → GitHub outage.
# KEEPALIVE_HEALTH_URL=https://your-api.onrender.com/health
